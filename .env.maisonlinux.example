# Futur deploiement MaisonLinux / LAN stable.
# Par defaut, l'exposition LAN evite 80/443. Pour dedier MaisonLinux au jeu,
# remplacer TRAEFIK_HTTP_PORT=80 et TRAEFIK_HTTPS_PORT=443.

COMPOSE_PROJECT_NAME=cabinet-maisonlinux
STACK_ID=cabinet-maisonlinux
STACK_NETWORK=cabinet_maisonlinux_net

TRAEFIK_DOMAIN=cabinet.maisonlinux.lan
TRAEFIK_HOST_UI=app.cabinet.maisonlinux.lan
TRAEFIK_HOST_API=api.cabinet.maisonlinux.lan
TRAEFIK_HOST_LOBBY=lobby.cabinet.maisonlinux.lan
TRAEFIK_HOST_UI_ETAT=ui-etat.cabinet.maisonlinux.lan
TRAEFIK_HOST_KAFKA_UI=kafka.cabinet.maisonlinux.lan
TRAEFIK_HOST_REGISTRY=registry.cabinet.maisonlinux.lan
TRAEFIK_HOST_RULES=rules.cabinet.maisonlinux.lan

TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
TRAEFIK_API_PORT=8085

PUBLIC_BASE_URL=http://app.cabinet.maisonlinux.lan:8080
CORS_ORIGINS=http://app.cabinet.maisonlinux.lan:8080,http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
JEU_DB=jeu
JEU_DB_USER=jeu
JEU_DB_PASSWORD=changeme

KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=CHANGE_ME_22_CHARS_ID
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

REGISTRY_LOG_LEVEL=INFO

KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=changeme

TOPICS=cab.commands,cab.events,cabinet.joueurs.evenements,cabinet.tables.evenements,cabinet.parties.evenements

LOBBY_PERSISTENCE_BACKEND=postgres
LOBBY_ID_MODE=uuid
LOBBY_KAFKA_ACTIF=true
LOBBY_TIMEOUT_PARTIE_ACTIF=true
LOBBY_TIMEOUT_PARTIE_DELAI_INACTIVITE_SECONDES=3600

CAB_RULES_BRE_URL=http://rules-service:8081
