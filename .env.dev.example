# Developpement sur MaisonNeuve.
# Commande:
# docker compose --env-file .env.dev.example -p cabinet-dev-test -f docker-compose.yml -f docker-compose.dev.yml config --quiet

COMPOSE_PROJECT_NAME=cabinet-dev
STACK_ID=cabinet-dev
STACK_NETWORK=cabinet_dev_net

TRAEFIK_DOMAIN=cabinet-dev.localhost
TRAEFIK_HOST_UI=app.cabinet-dev.localhost
TRAEFIK_HOST_API=api.cabinet-dev.localhost
TRAEFIK_HOST_LOBBY=lobby.cabinet-dev.localhost
TRAEFIK_HOST_UI_ETAT=ui-etat.cabinet-dev.localhost
TRAEFIK_HOST_KAFKA_UI=kafka.cabinet-dev.localhost
TRAEFIK_HOST_REGISTRY=registry.cabinet-dev.localhost
TRAEFIK_HOST_RULES=rules.cabinet-dev.localhost

TRAEFIK_HTTP_PORT=18080
TRAEFIK_HTTPS_PORT=18443
TRAEFIK_API_PORT=18085

POSTGRES_PORT=15432
KAFKA_PLAINTEXT_PORT=19092
KAFKA_CONTROLLER_PORT=19093
KAFKA_UI_PORT=18082
REGISTRY_HTTP_PORT=18086
RULES_HTTP_PORT=18081
LOBBY_HTTP_PORT=18083

PUBLIC_BASE_URL=http://app.cabinet-dev.localhost:18080
CORS_ORIGINS=http://app.cabinet-dev.localhost:18080,http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres
JEU_DB=jeu
JEU_DB_USER=jeu
JEU_DB_PASSWORD=changeme

KAFKA_BROKER_ID=1
KAFKA_CLUSTER_ID=CHANGE_ME_22_CHARS_ID
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false

REGISTRY_LOG_LEVEL=INFO

KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=changeme

TOPICS=cab.commands,cab.events,cabinet.joueurs.evenements,cabinet.tables.evenements,cabinet.parties.evenements

LOBBY_PERSISTENCE_BACKEND=postgres
LOBBY_ID_MODE=uuid
LOBBY_KAFKA_ACTIF=true
LOBBY_TIMEOUT_PARTIE_ACTIF=true
LOBBY_TIMEOUT_PARTIE_DELAI_INACTIVITE_SECONDES=3600

CAB_RULES_BRE_URL=http://rules-service:8081
